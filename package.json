{
	"name": "sort-wrangler-json",
	"version": "1.0.0",
	"description": "An opinionated JSON and JSONC sorter for Wrangler configuration files.",
	"license": "MIT",
	"type": "module",
	"bin": "./cli.ts",
	"files": [
		"./cli.ts"
	],
	"scripts": {
		"check": "pnpm run fmt:check && pnpm run lint",
		"check:fix": "pnpm run fmt && pnpm run lint:fix",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix --fix-suggestions --fix-dangerously",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"eslint": "catalog:",
		"eslint-plugin-jsonc": "catalog:",
		"jsonc-eslint-parser": "catalog:"
	},
	"devDependencies": {
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/types": "catalog:",
		"@stylistic/eslint-plugin": "catalog:",
		"@types/json-schema": "catalog:",
		"@types/node": "catalog:",
		"globals": "catalog:",
		"lefthook": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"eslint": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "25.6.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=23.6.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
