{
	"name": "sort-wrangler-json",
	"version": "1.0.0",
	"description": "An opinionated JSON and JSONC sorter for Wrangler configuration files.",
	"license": "MIT",
	"type": "module",
	"bin": "./cli.ts",
	"files": [
		"./cli.ts"
	],
	"scripts": {
		"check": "biome check",
		"check:write": "biome check --write --unsafe",
		"format": "biome format",
		"format:write": "biome format --write",
		"lint": "biome lint",
		"lint:write": "biome lint --write --unsafe",
		"test": "vitest run",
		"test:watch": "vitest",
		"types:check": "tsc",
		"prepare": "husky"
	},
	"dependencies": {
		"eslint": "catalog:",
		"eslint-plugin-jsonc": "catalog:",
		"jsonc-eslint-parser": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@commitlint/cli": "catalog:",
		"@commitlint/config-conventional": "catalog:",
		"@commitlint/types": "catalog:",
		"@types/json-schema": "catalog:",
		"@types/node": "catalog:",
		"husky": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:",
		"zod": "catalog:"
	},
	"peerDependencies": {
		"eslint": "catalog:"
	},
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "^11.0.0",
			"onFail": "download"
		},
		"runtime": {
			"name": "node",
			"version": "25.6.1",
			"onFail": "download"
		}
	},
	"engines": {
		"node": ">=23.6.0"
	},
	"publishConfig": {
		"access": "public"
	}
}
